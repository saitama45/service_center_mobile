<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only manifest overlay: merged in ONLY for debug builds (flutter run,
  flutter build apk with the debug flavor). Release builds never see this
  file, so android:usesCleartextTraffic="false" in the main manifest is
  untouched.

  Adds a network security config that permits plain HTTP to the handful of
  hosts used to reach a local dev server from the emulator or a device, so
  the API_BASE_URL dart define override (see ApiClient) can point at
  http colon slash slash 10.0.2.2 colon PORT without weakening the release
  build's TLS-only policy.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
