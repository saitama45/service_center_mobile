{
  "permissions": {
    "allow": [
      "Bash(unzip -p \"BMS_Technical_Specification.docx\" word/document.xml)",
      "Bash(sed 's/<[^>]*>//g')",
      "Bash(grep -v '^[[:space:]]*$')",
      "Read(//d/My Data/Documents/App/flutter/**)",
      "Bash(flutter create:*)",
      "Bash(where flutter:*)",
      "Read(//c/Users/TAS/AppData/Local/**)",
      "Read(//c//**)",
      "Bash(cmd.exe /c \"where flutter\")",
      "Bash(cmd.exe /c \"flutter --version\")",
      "Bash(cmd.exe /c \"flutter --version 2>&1\")",
      "Bash(powershell.exe -Command \"Get-Command flutter -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Source\")",
      "Bash(powershell.exe -Command \"Get-ChildItem -Path ''C:\\\\'', ''D:\\\\'' -Recurse -Filter ''flutter.bat'' -ErrorAction SilentlyContinue | Select-Object -First 5 -ExpandProperty FullName\")",
      "Bash(powershell.exe -NoProfile -Command \":*)"
    ]
  }
}
